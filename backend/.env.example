# SmartFridge AI - Environment Variables
PROJECT_NAME="SmartFridge AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT
SECRET_KEY="smartfridge_ai_super_secret_jwt_key_for_development_environment"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/smartfridge_db"
# Fallback local sqlite database if postgres is not yet initialized:
SQLITE_FALLBACK_URL="sqlite:///./smartfridge_dev.db"
USE_SQLITE_FALLBACK_IF_PG_UNAVAILABLE=True

# CORS Settings (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Storage
UPLOAD_DIR="./uploads"

# Simulation Modes
SIMULATION_MODE=True
PAYMENT_PROVIDER="razorpay_simulation"
SHOPPING_PROVIDER="internal_simulation"
